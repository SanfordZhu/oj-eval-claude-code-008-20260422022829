# Problem 2277: if else - simpler version
# Read two chars
[0]<I
[1]<I

# Compare: if [0] == [1] output '1', else '0'
# Set flag at memory[[0]] = 1
A<[0]
[A]<1

# Check memory[[1]]
B<[1]
C<[B]

# C = 1 if equal, 0 if not
# Output '0' or '1'
# Store output chars at addresses 200, 201
[200]<48  # '0'
[201]<49  # '1'

O<[200+C]

Z<1